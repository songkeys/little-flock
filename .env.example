# Replace with: openssl rand -hex 24
# Hex avoids URL escaping when Compose constructs DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password

# Docker Compose only. Development Vite runs on 4318, Go runs on 8080.
APP_PORT=8081

# For running Go directly with an external PostgreSQL database, export this
# in your shell. The Go process does not load .env files automatically.
# DATABASE_URL=postgres://flock:YOUR_PASSWORD@127.0.0.1:5432/flock?sslmode=disable
